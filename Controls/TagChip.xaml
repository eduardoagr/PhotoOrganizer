<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="PhotoOrganizer.Controls.TagChip"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="tagChip">

    <Border x:Name="ChipBorder" Padding="10">

        <Border.StrokeShape>
            <RoundRectangle CornerRadius="20" />
        </Border.StrokeShape>

        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding Command, Source={x:Reference tagChip}}" CommandParameter="{Binding CommandParameter, Source={x:Reference tagChip}}" />
        </Border.GestureRecognizers>


        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5">

            <BoxView
                BackgroundColor="{Binding ChipColor, Source={x:Reference tagChip}}"
                HeightRequest="20"
                WidthRequest="20" />

            <Label
                Grid.Column="1"
                FontSize="16"
                Text="{Binding Text, Source={x:Reference tagChip}}"
                VerticalTextAlignment="Center" />

        </Grid>
    </Border>
</ContentView>
