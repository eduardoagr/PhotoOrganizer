<ContentView
    x:Class="PhotoOrganizer.Controls.IconButton"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:app="http://schemas.photoorganizer.com"
    x:Name="iconButton"
    x:DataType="app:IconButton">

    <Button
        Command="{Binding Command, Source={x:Reference iconButton}}"
        CommandParameter="{Binding CommandParameter, Source={x:Reference iconButton}}"
        ContentLayout="Left, 10"
        HorizontalOptions="End"
        Text="{Binding Text, Source={x:Reference iconButton}}"
        TextColor="Black">

        <Button.ImageSource>
            <FontImageSource
                FontFamily="MaterialIconsRound"
                Glyph="{Binding Glyph, Source={x:Reference iconButton}}"
                Size="20"
                Color="{AppThemeBinding Light=#FFFFFF,Dark=#292D43}" />
        </Button.ImageSource>

    </Button>
</ContentView>