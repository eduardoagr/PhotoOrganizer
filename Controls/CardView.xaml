<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="PhotoOrganizer.Controls.CardView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Border
        Margin="10"
        Padding="12"
        BackgroundColor="{AppThemeBinding Light=#FFFFFF,
                                          Dark=#1E2029}"
        Stroke="{AppThemeBinding Light=#E6E8F0,
                                 Dark=#30333E}"
        StrokeThickness="1">

        <Border.StrokeShape>
            <RoundRectangle CornerRadius="16" />
        </Border.StrokeShape>

        <ContentPresenter />

    </Border>

</ContentView>
