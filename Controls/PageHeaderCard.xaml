<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="PhotoOrganizer.Controls.PageHeaderCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="PageHeader">

    <VerticalStackLayout>

        <Label
            FontAttributes="Bold"
            FontSize="29"
            Text="{Binding Title, Source={x:Reference PageHeader}}"
            TextColor="{AppThemeBinding Light=#20243A,
                                        Dark=#F5F5FA}" />

        <Label
            FontSize="14"
            LineBreakMode="WordWrap"
            Text="{Binding Subtitle, Source={x:Reference PageHeader}}"
            TextColor="{AppThemeBinding Light=#73788C,
                                        Dark=#A7AABD}" />

    </VerticalStackLayout>
</ContentView>
