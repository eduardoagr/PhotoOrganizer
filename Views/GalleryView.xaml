<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PhotoOrganizer.Views.GalleryView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:app="http://schemas.photoorganizer.com"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Name="galleryPage"
    x:DataType="app:GalleryViewModel"
    BackgroundColor="{AppThemeBinding Light=#F6F7FB,
                                      Dark=#121318}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding Path=BindingContext, Source={x:Reference galleryPage}}"
            Command="{Binding LoadTagsCommand}"
            EventName="NavigatedTo" />
    </ContentPage.Behaviors>

    <VerticalStackLayout Padding="10" Spacing="10">

        <CollectionView ItemsSource="{Binding Tags}">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout ItemSpacing="10" Orientation="Horizontal" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="app:Tag">
                    <app:TagChip
                        ChipColor="{Binding Color}"
                        Command="{Binding Path=BindingContext.FilterByTagCommand, Source={x:Reference galleryPage}}"
                        CommandParameter="{Binding}"
                        IsSelected="{Binding isSelected}"
                        Text="{Binding Name}" />
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <CollectionView ItemsSource="{Binding Photos}">

            <CollectionView.ItemsLayout>
                <GridItemsLayout
                    HorizontalItemSpacing="8"
                    Orientation="Vertical"
                    Span="3"
                    VerticalItemSpacing="8" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="app:Photo">

                    <Border
                        Margin="2"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="2">

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Path=BindingContext.OpenPhotoDetailCommand, Source={x:Reference galleryPage}}" CommandParameter="{Binding FilePath}" />
                        </Border.GestureRecognizers>

                        <Image
                            Aspect="AspectFill"
                            HeightRequest="120"
                            Source="{Binding FilePath}" />

                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </VerticalStackLayout>

</ContentPage>