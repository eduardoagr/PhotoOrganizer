<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PhotoOrganizer.Views.GalleryView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:app="http://schemas.photoorganizer.com"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Name="galleryPage"
    x:DataType="app:GalleryViewModel"
    BackgroundColor="{AppThemeBinding Light=#F6F7FB,
                                      Dark=#121318}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding Path=BindingContext, Source={x:Reference galleryPage}, x:DataType=ContentPage}"
            Command="{Binding InitializeCommand}"
            EventName="NavigatedTo" />
    </ContentPage.Behaviors>

    <Shell.TitleView>
        <HorizontalStackLayout
            Padding="10"
            HorizontalOptions="End"
            Spacing="10"
            VerticalOptions="Center">
            <Label Style="{StaticResource ToolbarItem}" Text="{Static app:IconFont.Filter_alt}">
                <Label.Behaviors>
                    <toolkit:TouchBehavior
                        BindingContext="{Binding Source={x:Reference galleryPage}, Path=BindingContext}"
                        Command="{Binding FilterPopupOpenCommand}"
                        PressedOpacity="0.5"
                        PressedScale="1" />
                </Label.Behaviors>
            </Label>

            <Label Style="{StaticResource ToolbarItem}" Text="{Static app:IconFont.Share}">

                <Label.Behaviors>
                    <toolkit:TouchBehavior
                        BindingContext="{Binding Source={x:Reference galleryPage}, Path=BindingContext}"
                        Command="{Binding FilterPopupOpenCommand}"
                        PressedOpacity="0.5"
                        PressedScale="1" />
                </Label.Behaviors>
            </Label>
            
            <Label Style="{StaticResource ToolbarItem}" Text="{Static app:IconFont.More_vert}">

                <Label.Behaviors>
                    <toolkit:TouchBehavior
                        BindingContext="{Binding Source={x:Reference galleryPage}, Path=BindingContext}"
                        Command="{Binding FilterPopupOpenCommand}"
                        PressedOpacity="0.5"
                        PressedScale="1" />
                </Label.Behaviors>
            </Label>

        </HorizontalStackLayout>
    </Shell.TitleView>

    <VerticalStackLayout Padding="10" Spacing="10">

        <CollectionView IsGrouped="True" ItemsSource="{Binding PhotoGroups}">

            <CollectionView.ItemsLayout>
                <GridItemsLayout
                    HorizontalItemSpacing="8"
                    Orientation="Vertical"
                    Span="3"
                    VerticalItemSpacing="8" />
            </CollectionView.ItemsLayout>

            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="app:PhotoGroup">
                    <Label
                        Margin="4,12,4,8"
                        FontAttributes="Bold"
                        FontSize="20"
                        Text="{Binding Title}" />
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="app:Photo">

                    <Border
                        Margin="2"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="2">

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Path=BindingContext.OpenPhotoDetailCommand, Source={x:Reference galleryPage}}" CommandParameter="{Binding FilePath}" />
                        </Border.GestureRecognizers>

                        <Image
                            Aspect="AspectFill"
                            HeightRequest="120"
                            Source="{Binding FilePath}" />

                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </VerticalStackLayout>

</ContentPage>