<?xml version="1.0" encoding="utf-8" ?>
<app:SfPopup
    x:Class="PhotoOrganizer.Views.NewTagDialogView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:app="http://schemas.photoorganizer.com"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    x:Name="RootPopup"
    Padding="20"
    x:DataType="app:NewTagDialogViewModel"
    AnimationMode="Zoom"
    AutoSizeMode="Both"
    ShowCloseButton="True"
    ShowHeader="False"
    StaysOpen="True">

    <app:SfPopup.PopupStyle>
        <app:PopupStyle CornerRadius="0" />
    </app:SfPopup.PopupStyle>

    <app:SfPopup.ContentTemplate>
        <DataTemplate x:DataType="app:NewTagDialogViewModel">
            <Grid
                Padding="10"
                RowDefinitions="Auto,Auto,Auto"
                RowSpacing="10">

                <app:SfTextInputLayout
                    Stroke="#393838"
                    Hint="Name"
                    Style="{StaticResource InputStyle}">

                    <Entry Text="{Binding newTag.Name}" TextColor="Black" />

                </app:SfTextInputLayout>

                <app:SfColorPicker
                    Grid.Row="1"
                    Margin="5,-20,0,0"
                    ColorMode="Spectrum"
                    DisplayViewStroke="Black"
                    HorizontalOptions="Start"
                    IsActionButtonsVisible="False"
                    SelectedColor="{Binding newTag.MauiColor}">
                    <app:SfColorPicker.DropDownButtonTemplate>
                        <DataTemplate>

                            <Label
                                FontFamily="MaterialIconsRound"
                                FontSize="24"
                                HorizontalTextAlignment="Center"
                                Text="{Static app:IconFont.Arrow_drop_down}"
                                TextColor="Black"
                                VerticalTextAlignment="Center" />

                        </DataTemplate>
                    </app:SfColorPicker.DropDownButtonTemplate>
                </app:SfColorPicker>

                <HorizontalStackLayout
                    Grid.Row="2"
                    HorizontalOptions="Center"
                    Spacing="10">

                    <Button
                        Command="{Binding SaveTagCommand}"
                        HorizontalOptions="End"
                        Text="Save" />

                    <Button
                        Command="{Binding SaveTagCommand}"
                        HorizontalOptions="End"
                        Text="Cancel" />
                </HorizontalStackLayout>

            </Grid>
        </DataTemplate>
    </app:SfPopup.ContentTemplate>

</app:SfPopup>
