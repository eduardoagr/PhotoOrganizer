<?xml version="1.0" encoding="utf-8" ?>
<sfPopup:SfPopup
    x:Class="PhotoOrganizer.Views.NewTagDialogView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:app="http://schemas.photoorganizer.com"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:inputs="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
    xmlns:sfPopup="clr-namespace:Syncfusion.Maui.Popup;assembly=Syncfusion.Maui.Popup"
    x:Name="RootPopup"
    Padding="20"
    x:DataType="app:NewTagDialogViewModel"
    AnimationMode="Zoom"
    AutoSizeMode="Both"
    ShowHeader="False"
    StaysOpen="True">

    <sfPopup:SfPopup.PopupStyle>
        <sfPopup:PopupStyle CornerRadius="0" />
    </sfPopup:SfPopup.PopupStyle>

    <sfPopup:SfPopup.ContentTemplate>
        <DataTemplate x:DataType="app:NewTagDialogViewModel">
            <Grid
                Padding="10"
                RowDefinitions="Auto,Auto,Auto"
                RowSpacing="10">

                <inputLayout:SfTextInputLayout ContainerType="Outlined" Hint="Name">

                    <Entry Text="{Binding newTag.Name}" TextColor="Black" />

                </inputLayout:SfTextInputLayout>

                <inputs:SfColorPicker
                    Grid.Row="1"
                    ColorMode="Spectrum"
                    DisplayViewStroke="Black"
                    HorizontalOptions="Start"
                    IsActionButtonsVisible="False"
                    SelectedColor="{Binding newTag.MauiColor}">
                    <inputs:SfColorPicker.DropDownButtonTemplate>
                        <DataTemplate>

                            <Label
                                FontFamily="MaterialIconsRound"
                                FontSize="24"
                                HorizontalTextAlignment="Center"
                                Text="{Static app:IconFont.Arrow_drop_down}"
                                TextColor="Black"
                                VerticalTextAlignment="Center" />

                        </DataTemplate>
                    </inputs:SfColorPicker.DropDownButtonTemplate>
                </inputs:SfColorPicker>

                <Button
                    Grid.Row="2"
                    Command="{Binding SaveTagCommand}"
                    HorizontalOptions="End"
                    Text="Save" />
            </Grid>
        </DataTemplate>
    </sfPopup:SfPopup.ContentTemplate>

</sfPopup:SfPopup>
