<?xml version="1.0" encoding="utf-8" ?>
<app:SfPopup
    x:Class="PhotoOrganizer.Views.NewTagDialogView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:app="http://schemas.photoorganizer.com"
    x:Name="RootPopup"
    Padding="20"
    x:DataType="app:NewTagDialogViewModel"
    AutoSizeMode="Both"
    Closed="RootPopup_Closed"
    ShowHeader="False"
    StaysOpen="True">

    <app:SfPopup.PopupStyle>
        <app:PopupStyle MessageBackground="{AppThemeBinding Light=#FFFFFF, Dark=#292D43}" />
    </app:SfPopup.PopupStyle>

    <app:SfPopup.ContentTemplate>
        <DataTemplate x:DataType="app:NewTagDialogViewModel">
            <Grid Padding="10" RowDefinitions="Auto,Auto,Auto">

                <app:SfTextInputLayout
                    Hint="Name"
                    Stroke="#393838"
                    Style="{StaticResource InputStyle}">

                    <Entry Text="{Binding newTag.Name}" />

                </app:SfTextInputLayout>

                <app:SfColorPicker
                    Grid.Row="1"
                    Margin="5,-20,0,0"
                    ColorMode="Palette"
                    HorizontalOptions="Start"
                    IsInline="True"
                    PopupBackground="Transparent"
                    SelectedColor="{Binding newTag.MauiColor}"
                    ShowRecentColors="False" />

                <Grid Grid.Row="2" Padding="10">

                    <app:IconButton
                        Command="{Binding SaveTagCommand}"
                        Glyph="{Static app:IconFont.Save}"
                        HorizontalOptions="End"
                        Text="Save" />

                    <app:IconButton
                        Command="{Binding CancelCommand}"
                        Glyph="{Static app:IconFont.Cancel}"
                        HorizontalOptions="Start"
                        Text="Cancel" />

                </Grid>

            </Grid>
        </DataTemplate>
    </app:SfPopup.ContentTemplate>

</app:SfPopup>
