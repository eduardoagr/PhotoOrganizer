<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PhotoOrganizer.Views.CreatePhotoView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:app="http://schemas.photoorganizer.com"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Name="HomeView"
    x:DataType="app:CreatePhotoViewModel"
    BackgroundColor="{AppThemeBinding Light=#F6F7FB,
                                      Dark=#121318}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding Path=BindingContext, Source={x:Reference HomeView}, x:DataType=ContentPage}"
            Command="{Binding InitializeCommand}"
            EventName="NavigatedTo" />
    </ContentPage.Behaviors>

    <Shell.TitleView>
        <Grid Padding="10" HorizontalOptions="End">
            <Label
                x:Name="AccountLabel"
                FontFamily="MaterialIconsRound"
                FontSize="32"
                HorizontalTextAlignment="End"
                Text="{Static app:IconFont.Menu}"
                VerticalTextAlignment="Center">

                <Label.Behaviors>
                    <toolkit:TouchBehavior
                        BindingContext="{Binding Source={x:Reference HomeView}, Path=BindingContext}"
                        Command="{Binding ShowAccountDialogCommand}"
                        PressedOpacity="0.5"
                        PressedScale="1" />
                </Label.Behaviors>
            </Label>
        </Grid>
    </Shell.TitleView>

    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout>

            <app:PageHeaderCard
                Title="Capture a moment"
                Margin="10"
                Subtitle="Save a photo, add some details, and keep everything organized." />

            <Border
                Margin="10"
                Padding="12"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="14">

                    <app:PhotoCaptureCard
                        CaptureCommand="{Binding TakePhotoCommand}"
                        IsPhotoEmpty="{Binding IsPhotoEmpty}"
                        IsPhotoTaken="{Binding IsPhotoTaken}"
                        Location="{Binding Photo.LocationDescription}"
                        PhotoPath="{Binding Photo.PhotoPath}" />

                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Margin="10" Spacing="14">

                <Label
                    Margin="10,0,0,0"
                    FontAttributes="Bold"
                    FontSize="21"
                    Text="Photo details"
                    TextColor="{AppThemeBinding Light=#20243A,
                                                Dark=#F5F5FA}" />

                <app:CardView>
                    <app:SfTextInputLayout Hint="Category" Style="{StaticResource InputStyle}">

                        <app:SfComboBox
                            x:Name="TagsCombo"
                            DisplayMemberPath="Name"
                            HeightRequest="40"
                            ItemsSource="{Binding Tags}"
                            SelectionChanged="TagsCombo_SelectionChanged"
                            TextColor="{AppThemeBinding Dark=#F0F1F8,
                                                        Light=#20243A}">

                            <app:SfComboBox.ItemTemplate>
                                <DataTemplate x:DataType="app:Tag">

                                    <Grid
                                        Padding="6,8"
                                        ColumnDefinitions="Auto,*"
                                        ColumnSpacing="10">

                                        <Border
                                            HeightRequest="20"
                                            Stroke="Black"
                                            StrokeThickness="2"
                                            WidthRequest="20">
                                            <BoxView
                                                BackgroundColor="{Binding Color}"
                                                HeightRequest="20"
                                                WidthRequest="20" />
                                        </Border>

                                        <Label
                                            Grid.Column="1"
                                            FontSize="16"
                                            Text="{Binding Name}"
                                            TextColor="Black"
                                            VerticalOptions="Center" />

                                    </Grid>
                                </DataTemplate>
                            </app:SfComboBox.ItemTemplate>
                        </app:SfComboBox>
                    </app:SfTextInputLayout>
                </app:CardView>

                <app:CardView>
                    <app:SfTextInputLayout Hint="Title" Style="{StaticResource InputStyle}">
                        <Entry Style="{StaticResource PhotoDetailsEntryStyle}" Text="{Binding Photo.Title}" />
                    </app:SfTextInputLayout>
                </app:CardView>

                <app:CardView>
                    <app:SfTextInputLayout Hint="Description" Style="{StaticResource InputStyle}">
                        <Entry Style="{StaticResource PhotoDetailsEntryStyle}" Text="{Binding Photo.Description}" />
                    </app:SfTextInputLayout>
                </app:CardView>
            </VerticalStackLayout>

            <Button
                Margin="10"
                Command="{Binding SavePictureCommand}"
                Style="{StaticResource SaveDatabaseButton}" />

            <Label
                Padding="5"
                FontSize="14"
                HorizontalTextAlignment="Center"
                Text="Your memories, beautifully organized."
                TextColor="{AppThemeBinding Light=#969AAA,
                                            Dark=#85899A}" />
            <app:LoginDialogView />
            <app:UserAccountDialog RelativePosition="AlignBottom" RelativeView="{x:Reference AccountLabel}" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>