<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PhotoOrganizer.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:icons="clr-namespace:PhotoOrganizer.Icons"
    xmlns:views="clr-namespace:PhotoOrganizer.Views"
    Title="PhotoOrganizer">

    <TabBar>

        <!--  CREATE TAB  -->
        <Tab Title="Create">
            <Tab.Icon>
                <FontImageSource FontFamily="MaterialIconsRound" Glyph="{x:Static icons:IconFont.Add}" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:CreatePhotoView}" />
        </Tab>

        <!--  PHOTOS TAB  -->
        <Tab Title="Photos">
            <Tab.Icon>
                <FontImageSource FontFamily="MaterialIconsRound" Glyph="{x:Static icons:IconFont.Photo_library}" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:GalleryView}" />
        </Tab>
    </TabBar>

</Shell>
